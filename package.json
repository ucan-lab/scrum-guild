{
  "name": "scrum-guild",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.12.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "node scripts/prepare.ts && node scripts/git-hooks.ts",
    "dev": "node scripts/prepare.ts && node scripts/dev.ts",
    "dev:open": "node scripts/dev-open.ts",
    "build": "vite build && node scripts/write-headers.ts",
    "preview": "pnpm build && node scripts/dev.ts --preview",
    "check": "node scripts/prepare.ts && svelte-check --tsconfig ./tsconfig.json && tsc -p src/server/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/prepare.ts && vitest run && node --test scripts/*.test.ts",
    "e2e": "playwright test",
    "db:migrate:fresh": "node scripts/migrate-fresh.ts",
    "db:seed": "node scripts/db-seed.ts"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "decode-named-character-reference": "^1.3.0",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.13.13",
    "kysely": "^0.29.7",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm-autolink-literal": "^2.0.1",
    "mdast-util-gfm-strikethrough": "^2.0.1",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "micromark-extension-gfm-autolink-literal": "^2.1.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@eslint/js": "^10.0.1",
    "@fontsource/biz-udpgothic": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/zen-old-mincho": "^5.3.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "~4.1.12",
    "wrangler": "^4.152.0"
  }
}
