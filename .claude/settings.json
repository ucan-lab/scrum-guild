{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "japanese",
  "env": {
    "WRANGLER_SEND_METRICS": "false"
  },
  "permissions": {
    "allow": [
      "Bash(git push --force-with-lease *)",
      "Bash(git push --force-with-lease=*)",
      "Bash(pnpm check)",
      "Bash(pnpm lint)",
      "Bash(pnpm format:check)",
      "Bash(pnpm test)",
      "Bash(node --test .claude/hooks/guards.test.mjs)",
      "mcp__github__issue_read",
      "mcp__github__pull_request_read",
      "mcp__github__list_issues",
      "mcp__github__list_pull_requests",
      "mcp__github__list_commits",
      "mcp__github__list_branches",
      "mcp__github__search_issues",
      "mcp__github__search_pull_requests",
      "mcp__github__get_commit",
      "mcp__github__get_check_run",
      "mcp__github__get_job_logs",
      "mcp__github__actions_get",
      "mcp__github__actions_list"
    ],
    "deny": [
      "Read(./**/.dev.vars)",
      "Read(./**/.dev.vars.local)",
      "Read(./**/.dev.vars.development)",
      "Read(./**/.dev.vars.test)",
      "Read(./**/.dev.vars.staging)",
      "Read(./**/.dev.vars.production)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.test)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.production)",
      "Edit(./**/.dev.vars)",
      "Edit(./**/.env)",
      "Read(~/.wrangler/**)",
      "Read(~/.config/.wrangler/**)",
      "Read(~/Library/Preferences/.wrangler/**)"
    ]
  },
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 600,
            "statusMessage": "依存を入れています"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-files.mjs\"",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
