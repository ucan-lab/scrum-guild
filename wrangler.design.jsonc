  "name": "scrum-guild-design",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./design"
  },
  "workers_dev": true,
  // 版ごとのプレビュー URL は Access の外に出るので作らない
  "preview_urls": false
}
